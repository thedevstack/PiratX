<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <!-- Content runs the full height; the bars below float on top of it and
             CallsFragment pads its list clear of them via FloatingBars. -->
        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:background="@android:color/transparent"
            android:stateListAnimator="@null"
            app:elevation="0dp"
            app:liftOnScroll="false">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/floating_bar_margin"
                android:layout_marginTop="@dimen/floating_bar_margin_top"
                android:layout_marginEnd="@dimen/floating_bar_margin"
                android:layout_marginBottom="@dimen/floating_bar_margin"
                android:background="@drawable/bg_floating_bar"
                android:elevation="@dimen/floating_toolbar_elevation"
                android:minHeight="@dimen/floating_toolbar_height"
                app:buttonGravity="center_vertical"
                app:title="@string/calls" />

        </com.google.android.material.appbar.AppBarLayout>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="@dimen/floating_nav_bar_height"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="@dimen/floating_bar_margin"
            android:layout_marginHorizontal="@dimen/floating_bar_margin_horizontal"
            android:background="@drawable/bg_floating_nav"
            android:elevation="@dimen/floating_nav_elevation"
            app:labelVisibilityMode="labeled"
            app:activeIndicatorLabelPadding="@dimen/floating_nav_label_padding"
            app:itemPaddingTop="@dimen/floating_nav_item_padding_top"
            app:itemPaddingBottom="@dimen/floating_nav_item_padding_bottom"
            app:itemTextAppearanceActive="@style/TextAppearance.App.NavigationBarLabel"
            app:itemTextAppearanceInactive="@style/TextAppearance.App.NavigationBarLabel"
            app:menu="@menu/bottom_navigation_menu_calls" />

    </RelativeLayout>
</layout>
